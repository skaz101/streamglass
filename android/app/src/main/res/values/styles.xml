<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ef233c</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080808</item>
        <item name="android:navigationBarColor">#080808</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#080808</item>
    </style>
    <style name="PlayerSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/player_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/player_sheet_exit</item>
    </style>
</resources>
